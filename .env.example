# Which provider/model to use.
# Default is Gemini's free-tier-friendly Flash model.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash

# Get a FREE key at https://aistudio.google.com/  ->  "Get API key"
GEMINI_API_KEY=

# Only needed if you switch LLM_PROVIDER above:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Passes over the task set during `python run.py train`
EPOCHS=2

# Hard cap on total LLM calls per run (throttle + retry come later).
MAX_LLM_CALLS=5
